# Copy to .env and use the existing database's password. Never commit .env.
POSTGRES_HOST=data-engineering-postgres
POSTGRES_PORT=5432
POSTGRES_DB=data_engineering
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=replace-with-existing-database-password
POSTGRES_NETWORK=data-engineering-lab_default
# 8001 avoids the native EventFlow server already listening on 8000.
EVENTFLOW_PORT=8001
LOG_INGESTOR_PORT=8002
# Initial Grafana administrator credentials; use a unique password in .env.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-unique-grafana-password
