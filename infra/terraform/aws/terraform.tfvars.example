aws_profile         = "platform-lab"
aws_region          = "us-east-2"
project_name        = "platform-engineering-lab"
instance_type       = "t3.small"
root_volume_gib     = 30
# Set your expected account ID to guard against applying to the wrong account.
allowed_account_ids = []
# Pin the Amazon Linux 2023 x86_64 AMI from the reviewed plan.
ami_id = null
# Optional, account-wide alert; not a hard cap. No budget without an email.
budget_email       = ""
monthly_budget_usd = 25
